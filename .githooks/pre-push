#!/bin/sh

# Git Pre-Push Hook: Mencegah push langsung ke branch develop
protected_branch="develop"
current_branch=$(git symbolic-ref --short HEAD 2>/dev/null)

# 1. Cek jika branch saat ini adalah develop
if [ "$current_branch" = "$protected_branch" ]; then
    echo ""
    echo "=================================================================="
    echo " ❌ [BLOCKED] Push langsung dari branch '$protected_branch' DILARANG!"
    echo "=================================================================="
    echo " 💡 Alur yang benar:"
    echo "   1. Buat branch fitur : git checkout -b feature/nama-fitur"
    echo "   2. Push branch fitur : git push origin feature/nama-fitur"
    echo "   3. Buat Pull Request ke branch develop di GitHub"
    echo "=================================================================="
    echo ""
    exit 1
fi

# 2. Cek jika target push mengarah ke develop
while read -r local_ref local_sha remote_ref remote_sha
do
    case "$remote_ref" in
        *"$protected_branch"*)
            echo ""
            echo "=================================================================="
            echo " ❌ [BLOCKED] Push langsung ke branch '$protected_branch' DILARANG!"
            echo "=================================================================="
            echo " 💡 Alur yang benar:"
            echo "   1. Buat branch fitur : git checkout -b feature/nama-fitur"
            echo "   2. Push branch fitur : git push origin feature/nama-fitur"
            echo "   3. Buat Pull Request ke branch develop di GitHub"
            echo "=================================================================="
            echo ""
            exit 1
            ;;
    esac
done

exit 0